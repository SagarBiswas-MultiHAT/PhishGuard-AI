# PhishGuard Environment Configuration
# Copy this file to .env and fill in your keys:
# cp .env.example .env

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your-groq-key-here

# Optional Server Configurations
# FLASK_DEBUG=0
# PHISHGUARD_PORT=5000
# PHISHGUARD_HOST=127.0.0.1

# Optional Email Notifications for User Feedback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# FEEDBACK_RECIPIENT_EMAIL=your_email@gmail.com
